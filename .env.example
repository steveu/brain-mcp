# Template for the real .env at repo root, sourced by bin/brain-mcp-launcher.
# Copy to .env, fill in BRAIN_MCP_TOKEN, and chmod 600. Gitignored.
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env

# Bearer token Claude.ai sends in the Authorization header.
# Generate with: openssl rand -hex 32
BRAIN_MCP_TOKEN=

# Optional. Absolute path to the vault directory. Defaults to ~/brain/vault.
# BRAIN_VAULT=

# Optional. HTTP port (loopback bind). Defaults to 8765.
# PORT=

# Optional. Public HTTPS URL the tunnel exposes the server at,
# e.g. https://mini.tail-xxxx.ts.net. When set, brain-mcp serves the
# OAuth metadata, /register, /authorize, and /token endpoints needed
# for Claude.ai's custom-connector flow. When unset, only the bearer
# transport on /mcp is available.
# BRAIN_MCP_PUBLIC_URL=

# Optional. Path to the JSON file that persists DCR client records.
# Defaults to ~/data/brain-mcp/oauth.json. Single-user, append-only.
# BRAIN_MCP_OAUTH_STORE=

# Optional. Path to the read-side allowlist file consumed by list/fetch/grep.
# Defaults to <parent of BRAIN_VAULT>/allowlist (i.e. ~/brain/allowlist when
# BRAIN_VAULT=~/brain/vault). Re-read on every list/fetch/grep call. Server
# fails closed at startup if the file is missing.
# BRAIN_MCP_ALLOWLIST=

# Optional. JSONL audit log appended on every list/fetch/grep call: timestamp,
# tool, args, paths returned, redaction count by allowlist prefix. No content.
# Defaults to ~/data/brain-mcp/audit.log.
# BRAIN_MCP_AUDIT_LOG=

# --- trails (walk_route / save_route) ---

# Optional. Public base URL the trails map service is exposed at, used to build
# the walk_route map link. When unset, walk_route omits the map URL with a note.
# Set this once trails.<domain> is fronting the map service (later slice).
# TRAILS_HOST=https://trails.example.org

# Optional. Path to the trails route engine (route.py from the skills repo).
# Defaults to ~/skills/trails/route.py.
# ROUTE_PY=

# Optional. Scratch dir for route drafts (GPX + map HTML), one subdir per draft
# id. save_route reads drafts from here. Defaults to ~/data/trails.
# TRAILS_DATA_DIR=

# Optional. Relative tile path passed to the engine as --tile-base so the map
# HTML points at key-less served tiles instead of embedding the OS key. Defaults
# to /tiles when TRAILS_HOST is set (i.e. the tile proxy is deployed), else
# unset (a standalone key-ful/OpenTopoMap render). Set empty to force standalone.
# TRAILS_TILE_BASE=/tiles

# Optional. Salt mixed into the draft-id hash so the map URL is unguessable.
# Drafts keep the same id (and URL) for a given route name as long as this is
# stable. Generate with: openssl rand -hex 16.
# TRAILS_ID_SALT=
