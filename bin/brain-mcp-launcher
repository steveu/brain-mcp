#!/bin/bash
# Launcher for brain-mcp under launchd.
# Sources the repo-root .env, then execs the Node server with absolute paths.
# Driven by ~/Library/LaunchAgents/st.urm.brain-mcp.plist.

set -euo pipefail

ENV_FILE="$HOME/code/brain-mcp/.env"
SERVER="$HOME/code/brain-mcp/dist/main.js"
NODE="/opt/homebrew/bin/node"
LOG="$HOME/Library/Logs/brain-mcp.log"

exec >> "$LOG" 2>&1
ts() { date "+%Y-%m-%dT%H:%M:%S%z"; }
echo "=== $(ts) brain-mcp-launcher starting ==="

if [[ ! -f "$ENV_FILE" ]]; then
  echo "env file not found at $ENV_FILE — create it with BRAIN_MCP_TOKEN=..."
  exit 1
fi

# shellcheck disable=SC1090
set -a
source "$ENV_FILE"
set +a

if [[ -z "${BRAIN_MCP_TOKEN:-}" ]]; then
  echo "BRAIN_MCP_TOKEN is unset or empty in $ENV_FILE"
  exit 1
fi

if [[ ! -x "$NODE" ]]; then
  echo "node not found at $NODE — install with 'brew install node'"
  exit 1
fi

if [[ ! -f "$SERVER" ]]; then
  echo "server bundle not found at $SERVER — run 'npm run build' in the repo"
  exit 1
fi

exec "$NODE" "$SERVER"
